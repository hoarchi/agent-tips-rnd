{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-tips-rnd.local/schemas/benchmark_card.schema.json",
  "title": "BenchmarkCard",
  "type": "object",
  "required": ["id", "name", "purpose", "task_families", "metrics", "baselines", "leakage_controls"],
  "properties": {
    "id": { "type": "string", "pattern": "^bench_[a-zA-Z0-9_\\-]+$" },
    "name": { "type": "string" },
    "purpose": { "type": "string" },
    "task_families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "inclusion_rule"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "inclusion_rule": { "type": "string" },
          "negative_cases_required": { "type": "boolean", "default": true }
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "definition", "direction"],
        "properties": {
          "name": { "type": "string" },
          "definition": { "type": "string" },
          "direction": { "type": "string", "enum": ["higher_is_better", "lower_is_better"] }
        }
      }
    },
    "baselines": { "type": "array", "items": { "type": "string" } },
    "leakage_controls": { "type": "array", "items": { "type": "string" } },
    "pass_fail_criteria": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}

