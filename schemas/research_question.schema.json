{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-tips-rnd.local/schemas/research_question.schema.json",
  "title": "ResearchQuestion",
  "type": "object",
  "required": ["id", "question", "motivation", "null_hypothesis", "candidate_hypotheses", "operational_definitions"],
  "properties": {
    "id": { "type": "string", "pattern": "^rq_[a-zA-Z0-9_\\-]+$" },
    "question": { "type": "string" },
    "motivation": { "type": "string" },
    "seed_observations": { "type": "array", "items": { "type": "string" } },
    "null_hypothesis": { "type": "string" },
    "candidate_hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "hypothesis", "falsification_criteria"],
        "properties": {
          "id": { "type": "string" },
          "hypothesis": { "type": "string" },
          "falsification_criteria": { "type": "string" }
        }
      }
    },
    "operational_definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["term", "definition", "measurement"],
        "properties": {
          "term": { "type": "string" },
          "definition": { "type": "string" },
          "measurement": { "type": "string" }
        }
      }
    },
    "status": { "type": "string", "enum": ["draft", "active", "rejected", "answered"], "default": "draft" }
  },
  "additionalProperties": false
}

