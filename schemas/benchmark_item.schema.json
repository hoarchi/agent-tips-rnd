{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-tips-rnd.local/schemas/benchmark_item.schema.json",
  "title": "BenchmarkItems",
  "type": "object",
  "required": ["benchmark_id", "version", "items"],
  "properties": {
    "benchmark_id": { "type": "string" },
    "version": { "type": "string" },
    "program_id": { "type": "string" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "task_family",
          "answerable",
          "evidence_sufficiency",
          "required_evidence",
          "expected_localization",
          "privacy_level",
          "label_status"
        ],
        "properties": {
          "id": { "type": "string" },
          "drawing": {
            "type": "object",
            "required": ["handle"],
            "properties": {
              "handle": { "type": "string" },
              "internal_id": { "type": ["integer", "null"] },
              "filename": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          },
          "page": { "type": ["integer", "null"] },
          "question": { "type": "string" },
          "task_family": { "type": "string" },
          "secondary_task_families": { "type": "array", "items": { "type": "string" } },
          "answerable": { "type": "boolean" },
          "evidence_sufficiency": {
            "type": "string",
            "enum": ["sufficient", "insufficient", "ambiguous", "conflicting", "unknown"]
          },
          "canonical_answer": {},
          "acceptable_answer_variants": { "type": "array" },
          "required_evidence": { "type": "array" },
          "forbidden_evidence": { "type": "array" },
          "target_entities": { "type": "array" },
          "calculation": {},
          "expected_localization": { "type": "object" },
          "source_evidence_type": { "type": "array", "items": { "type": "string" } },
          "difficulty": { "type": "string", "enum": ["easy", "medium", "hard", "unknown"] },
          "ambiguity_notes": { "type": "string" },
          "privacy_level": { "type": "string", "enum": ["internal_private", "anonymized", "public", "synthetic"] },
          "label_status": { "type": "string", "enum": ["imported_seed", "draft", "reviewed", "adjudicated"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

